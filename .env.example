# Bangumi account and personal access token
BANGUMI_USERNAME=
BANGUMI_ACCESS_TOKEN=
BANGUMI_USER_AGENT=Bangumi2MAL/0.1 (personal self-hosted sync tool)

# Register an API client at https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://127.0.0.1:5000/oauth/mal/callback

# Generate these with: bangumi2mal hash-password / generate-secret
WEB_PASSWORD_HASH=
FLASK_SECRET_KEY=

DATABASE_PATH=data/app.db
REPORTS_DIR=reports
LOG_LEVEL=INFO

# Safe defaults. Set to true only after checking a dry run.
AUTO_SYNC_ENABLED=false
AUTO_SYNC_HOURS=6
MAL_WRITE_DELAY_SECONDS=1.0
AUTO_MATCH_THRESHOLD=0.94
AUTO_MATCH_MARGIN=0.08
ALLOW_DECREASE_WATCHED=false

# Set true when served behind HTTPS.
SESSION_COOKIE_SECURE=false
